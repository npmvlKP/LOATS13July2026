reports/performance/*.json

# P5 forward-test run logs (runtime evidence, graded by verify_p5_forward_test)
reports/p5_forward_test_*.json

# Health check intermediate run artifacts (keep health-final-*.json only)
reports/health/health-fast-*.json
reports/health/health-full-*.json
reports/health/health-*.json
!reports/health/health-final-*.json
reports/health/bandit.json
reports/health/coverage.json
reports/health/fast-fixes.json
reports/health/pip_audit.json
reports/health/run*.json
reports/health/only-probes.json

# F8-H-03 runtime verification report (generated artifact, external verifier emits
# reports/f8-h-03-verification.json; keep it out of the index)
reports/*.json

# Canonical P1 evidence of record (negations must sit AFTER reports/*.json —
# git honours the last matching rule). 084822 is the pre-sweep baseline;
# 20260904_040609 is the F8-L-03 discharge artifact (100/100 live TCS
# round trips, live-endpoint scope) so HC-29 passes from a fresh clone.
!reports/p1_analyze_latency_20260828_084822.json
!reports/p1_analyze_latency_20260904_040609.json

# Junk files
$null
[100%]
0.21.0
pytest_final*.log
bandit-report.json
pip-audit-core-report.json
results.json
coverage_floor_map.json
opencode.json

