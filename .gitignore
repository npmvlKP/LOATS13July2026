# Updated: 02-Sep-2026 (F8-C-02 repo hygiene remediation)

# Environment files
.env
.env.*
!.env.example
secrets.env

# Ruff-specific exclusions (env files are not Python)
.ruffignore

# Virtual environments (F8-C-02): loatsNEW/ was swept into the index by a
# `git add -A` during TODO-25 (commit 7a2ea233) - 9,939 machine-local,
# absolute-path-bound files. Venvs are re-derivable from pyproject.toml and
# requirements-*.txt; never track them.
loatsNEW/
.venv/
venv/
ENV/
/loats/
LOATS13July2026/

# Literal `~` directory (PowerShell expansion mishap, F8-C-02)
~/

